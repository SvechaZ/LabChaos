# คัดลอกเป็น .env แล้วแก้รหัสผ่าน   cp .env.example .env
# .env ไม่ขึ้น git ไฟล์นี้ขึ้น git ได้เพราะไม่มีรหัสจริง
#
# สร้างรหัสสุ่มได้ด้วย   openssl rand -base64 24

POSTGRES_PASSWORD=change-me
POSTGRES_DB=roombook
POSTGRES_USER=roombook

# พอร์ตของหน้าเว็บบน VM ถ้าพอร์ต 80 มีโปรแกรมอื่นใช้อยู่
WEB_PORT=80
